# --- Banco de dados (Postgres do docker-compose) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bm?schema=public"
# Banco usado pelos testes de integracao (npm test)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bm_test?schema=public"
# Conexoes do pool do Postgres (cada transacao interativa segura uma)
DATABASE_POOL_MAX=10

# --- Auth.js ---
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"
NEXTAUTH_URL="http://localhost:3000"
# Duracao da sessao em segundos (padrao 8h)
SESSION_MAX_AGE="28800"

# --- Aplicacao ---
APP_URL="http://localhost:3000"
APP_TIMEZONE="America/Sao_Paulo"
# Dados da empresa prestadora (cabecalho do boletim)
COMPANY_NAME="Prestadora Demo Ltda"
COMPANY_CNPJ="12345678000195"
COMPANY_EMAIL="contato@prestadora.demo"

# --- Armazenamento de arquivos ---
# local | s3 (s3 ainda nao implementado; interface pronta)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"

# --- E-mail ---
# dev  : grava o e-mail em EMAIL_DEV_DIR e loga o link no console (sem SMTP)
# smtp : envia via SMTP_* abaixo
EMAIL_PROVIDER="dev"
EMAIL_DEV_DIR="/tmp/bm-emails"
EMAIL_FROM="Medicoes <nao-responda@prestadora.demo>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- Seed (somente desenvolvimento) ---
SEED_PASSWORD="Demo@2026"

# --- Testes E2E (opcional) ---
# Caminho de um Chromium ja instalado, se nao quiser baixar os navegadores do Playwright
PLAYWRIGHT_CHROMIUM_PATH=""
